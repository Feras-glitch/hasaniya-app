{
  "name": "hasaniya",
  "productName": "المنظومة الحسنية",
  "version": "108.0.0",
  "description": "المنظومة الحسنية في السيرة النبوية، تطبيق مستقل بلا خادم",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hasaniya.app",
    "productName": "المنظومة الحسنية",
    "files": ["main.js", "preload.js", "package.json", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "portable" },
    "linux": { "target": "AppImage" }
  }
}
